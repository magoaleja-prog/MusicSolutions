{
    "name": "eider/music-solutions",
    "description": "MusicSolutions - plataforma para musicos: afinador, partituras, busqueda de musica y espacio para programadores.",
    "type": "project",
    "license": "MIT",
    "keywords": ["php", "music", "tuner", "sheet-music", "mvc"],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
