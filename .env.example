# Application
APP_NAME="MusicSolutions"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Madrid

# Database (XAMPP / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=solutions
DB_USERNAME=root
DB_PASSWORD=

# Uploads
UPLOAD_MAX_SIZE=10485760

# Optional: allow searching the public iTunes catalogue
MUSIC_SEARCH_EXTERNAL=true
